# MCP-transport: stdio (standard, MCP-klienten startar processen)
#                http  (servern lyssnar på MCP_HOST:MCP_PORT)
MCP_TRANSPORT=stdio

# HTTP-läge — används bara när MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=8011
# Generera med: python3 -c "import secrets; print(secrets.token_hex(32))"
MCP_API_KEY=byt_till_eget_starkt_api_nyckel

# PostgreSQL (rekommenderas)
DATABASE_URL=postgresql://mitt_db_anvandare:byt_till_eget_starkt_losenord@localhost:5432/riksdag

# SQLite (fallback — ingen vektorsökning)
# DATABASE_URL=sqlite:///echr_cache.db

# HUDOC-inställningar
HUDOC_SOKRESULTAT_MAX=50
HUDOC_TIMEOUT=30

# Cache-TTL: dagar innan metadata hämtas om från HUDOC (0 = cacha för alltid)
ECHR_CACHE_TTL_DAGAR=30

# Fulltext-cache: katalog för nedladdade HTML-filer (on-demand, rensas när fulltext finns i DB)
# Lämna tomt för standard (./fulltext_cache bredvid skriptet)
ECHR_FULLTEXT_CACHE_DIR=

# Schemaläggning (används av 02_synka_metadata.py --installera-schema)
# Schemaläggare: launchd (macOS, rekommenderas) eller cron (Linux/macOS)
SCHEMALAGGARE=launchd
# Cron-schema: standard 03:15 varje natt
CRON_SCHEMA=15 3 * * *
# Python-sökväg: relativ till skriptmappen, eller absolut sökväg
PYTHON_SOKVÄG=.venv/bin/python3

# Query-expansion — valfritt, inaktiverat som standard.
# Expanderar söktermen automatiskt med flerspråkiga juridiska ekvivalenter via LLM.
# Stöder alla OpenAI-kompatibla endpoints (Claude, OpenAI, Ollama m.fl.).
QUERY_EXPANSION_ENABLED=false
# QUERY_EXPANSION_BASE_URL=https://api.anthropic.com/v1
# QUERY_EXPANSION_API_KEY=din-api-nyckel
# QUERY_EXPANSION_MODEL=claude-haiku-4-5-20251001
# Promptfil (standard: prompts/expansion_prompt.txt bredvid skriptet)
# QUERY_EXPANSION_PROMPT_FILE=
